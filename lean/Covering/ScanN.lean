namespace Covering

/-- **Theorem (native_decide).** Every covering of ℤ by finitely many congruence classes with
distinct odd moduli `> 1` has lcm of moduli exceeding 675674. The scan uses `native_decide`
(trusts the Lean compiler); the mathematics (`no_covering_of_check`) is kernel-checked. -/
theorem odd_covering_lcm_gt_675674 (S : Finset Cls) (hgt : ∀ c ∈ S, 1 < c.d)
    (hodd : ∀ c ∈ S, Odd c.d) (hinj : ∀ c ∈ S, ∀ c' ∈ S, c.d = c'.d → c = c')
    (hcov : CoversZ S) : 675674 < S.lcm (·.d) :=
  odd_covering_lcm_gt_of_scan 675674
    (fun L hL hodd => scanChunk_spec 0 675674 ScanN.scan_675674 L (by omega) (by omega) hodd)
    S hgt hodd hinj hcov

end Covering
